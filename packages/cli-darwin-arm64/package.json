{
  "name": "@devver-inc/cli-darwin-arm64",
  "version": "0.0.1",
  "private": false,
  "description": "macOS arm64 executables for @devver-inc/cli",
  "homepage": "https://github.com/Devver-Inc/cli#readme",
  "bugs": {
    "url": "https://github.com/Devver-Inc/cli/issues"
  },
  "license": "MIT",
