  "repository": {
    "type": "git",
    "url": "git+https://github.com/Devver-Inc/cli.git"
  },
  "files": [
    "devver",
    "servers",
    "version"
  ],
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "test \"$(cat version)\" = \"$(node -p 'require(\"./package.json\").version')\" && test -x devver && test -x \"servers/$(cat version)/devver-server\" && { test ! -e fixture || test \"$DEVVER_ALLOW_NPM_FIXTURE\" = 1; }"
  }
}
