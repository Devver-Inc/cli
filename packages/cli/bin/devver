#!/bin/sh
set -eu
script=$0
while [ -L "$script" ]; do
  dir=$(CDPATH= cd -- "$(dirname -- "$script")" && pwd -P)
  link=$(readlink "$script")
  case $link in
    /*) script=$link ;;
    *) script=$dir/$link ;;
  esac
done
root=$(CDPATH= cd -- "$(dirname -- "$script")/.." && pwd -P)
case "$(uname -s):$(uname -m)" in
  Darwin:arm64) target=darwin-arm64 ;;
  Linux:x86_64) target=linux-x64 ;;
  *) echo 'devver: unsupported platform (requires macOS arm64 or Linux x64)' >&2; exit 1 ;;
esac
exec "$root/dist/$target/devver" "$@"
