{
 "name": "@devver/cli",
  "description": "Deploy and try your app in seconds",
  "version": "0.0.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/myorg/my-package.git"
  },
  "keywords": ["utility", "helper"],
  "author": "Your Name",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },

  "module": "src/index.tsx",
  "type": "module",
  "private": false,
  "bin": {
    "devver": "./src/index.tsx"
  },
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "cmd": "bun run src/index.tsx",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "publish": "bun publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.9",
    "ultracite": "^7.1.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "@effect/platform": "^0.94.3",
    "@flystorage/file-storage": "^1.2.2",
    "@flystorage/local-fs": "^1.2.0",
    "@logto/node": "^3.1.8",
    "@opentui/react": "^0.1.74",
    "@types/yargs": "^17.0.35",
    "effect": "^3.19.15",
    "js-yaml": "^4.1.1",
    "xdg-basedir": "^5.1.0",
    "yargs": "^18.0.0"
  }
}
