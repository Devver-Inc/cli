{
  "name": "devver-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Deploy and try your app in seconds",
  "keywords": [
    "helper",
    "utility"
  ],
  "homepage": "https://github.com/Devver-Inc/cli#readme",
  "bugs": {
    "url": "https://github.com/Devver-Inc/cli/issues"
  },
  "license": "MIT",
  "author": "Your Name",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Devver-Inc/cli.git"
  },
  "workspaces": [
    "packages/cli",
    "packages/cli-darwin-arm64",
    "packages/cli-linux-x64",
    "packages/server"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun --watch run packages/cli/src/cli/index.ts",
    "dev:build": "bun build --compile --watch --outfile devver packages/cli/src/cli/index.ts",
    "cmd": "bun run packages/cli/src/cli/index.ts",
    "build": "bun run scripts/build.ts",
    "build:npm": "bun run scripts/build-npm.ts",
    "check": "ultracite check --disable-nested-config && bun run lint:boundaries && bun run typecheck",
    "lint:boundaries": "depcruise packages tests scripts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 30000",
    "fix": "ultracite fix",
    "sync:version": "bun run scripts/sync-version.ts",
    "check:version": "bun run scripts/sync-version.ts --check",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@effect/tsgo": "^0.63.0",
    "@types/bun": "^1.4.4",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.3.0",
    "dependency-cruiser": "^18.7.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "7.0.2",
    "ultracite": "^8.1.0"
  }
}
