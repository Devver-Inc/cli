{
  "name": "devver-workspace",
  "version": "1.2.0",
  "private": true,
  "description": "Deploy and try your app in seconds",
  "keywords": [
    "utility",
    "helper"
  ],
  "homepage": "https://github.com/Devver-Inc/cli#readme",
  "bugs": {
    "url": "https://github.com/Devver-Inc/cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Devver-Inc/cli.git"
  },
  "license": "MIT",
  "author": "Your Name",
  "type": "module",
  "scripts": {
    "dev": "bun --watch run packages/cli/src/cli/index.ts",
    "dev:build": "bun build --compile --watch --outfile devver packages/cli/src/cli/index.ts",
    "cmd": "bun run packages/cli/src/cli/index.ts",
    "build": "bun run scripts/build.ts",
    "build:npm": "bun run scripts/build-npm.ts",
    "check": "ultracite check",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 30000",
    "fix": "ultracite fix",
    "sync:version": "bun run scripts/sync-version.ts",
    "check:version": "bun run scripts/sync-version.ts --check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@types/bun": "^1.3.6",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.9",
    "ultracite": "^7.1.5"
  },
  "workspaces": [
    "packages/cli",
    "packages/server"
  ]
}
