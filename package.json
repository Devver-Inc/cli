{
  "name": "devver-cli",
  "version": "0.0.1",
  "description": "Ultra-fast deployments and visual feedback for Devver",
  "module": "src/index.tsx",
  "type": "module",
  "bin": {
    "devver-cli": "./devver-cli"
  },
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "build": "bun build src/index.tsx --compile --outfile=devver-cli",
    "typecheck": "tsc --noEmit",
    "lint": "bunx @biomejs/biome check src/",
    "lint:fix": "bunx @biomejs/biome check --write src/",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "@types/react": "^19.2.9"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "0.1.74",
    "@opentui/react": "0.1.74",
    "@types/yargs": "^17.0.35",
    "yargs": "^18.0.0"
  },
  "overrides": {
    "@opentui/core": "0.1.74"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:Devver-Inc/cli.git"
  },
  "homepage": "https://devver.app"
}
